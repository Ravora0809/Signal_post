import json
import re
from datetime import datetime, timezone
from urllib.parse import urlparse

import structlog
from sqlalchemy.orm import Session

from ..adapters.http import SafeHTTPClient
from ..adapters.search import SearchAdapter
from ..models import Company, Source
from ..utils.canonical import canonicalize_url
from ..utils.hashing import sha256_hex, content_hash

log = structlog.get_logger()

STATIC_SOURCES_TEMPLATE = [
    "https://data.brreg.no/enhetsregisteret/api/enheter/{orgnr}",
    "https://data.brreg.no/enhetsregisteret/api/enheter/{orgnr}/roller",
]
REGNSKAP_URL = "https://data.brreg.no/regnskapsregisteret/regnskap/{orgnr}"


def _name_tokens(name: str) -> set[str]:
    stop = {"as", "asa", "nuf", "the", "and", "og"}
    return {x for x in re.findall(r"[a-z0-9æøå]+", (name or "").lower()) if len(x) >= 3 and x not in stop}


def _host(value: str | None) -> str:
    if not value:
        return ""
    raw = value.strip()
    if not raw:
        return ""
    if "://" not in raw:
        raw = "https://" + raw
    try:
        return (urlparse(raw).hostname or "").lower().removeprefix("www.")
    except Exception:
        return ""


def _same_official_domain(registered: str | None, candidate: str) -> bool:
    reg = _host(registered)
    src = _host(candidate)
    if not reg or not src:
        return False
    return src == reg or src.endswith("." + reg)


def _registered_website_from_brreg(body: str) -> str | None:
    try:
        data = json.loads(body)
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    value = data.get("hjemmeside")
    if isinstance(value, str) and value.strip():
        return value.strip()
    return None


def verify_source_identity(
    company: Company,
    url: str,
    body: str,
    kind: str,
) -> tuple[bool, str]:
    """Verify source ownership conservatively.

    - Brreg entity/roles are trusted first-party sources.
    - Regnskapsregisteret is trusted only when the returned JSON contains the
      exact requested organisation number.
    - A website is trusted only when its host matches the registered Brreg URL.
    - Search candidates are never trusted merely because the title looks right;
      they become trusted only when they land on the registered company domain
      or independently contain strong org/name evidence.
    """
    if kind == "brreg":
        return True, "trusted_brreg"

    if kind == "regnskap":
        if not body:
            return False, "empty_body"
        try:
            payload = json.loads(body)
        except Exception:
            return False, "invalid_regnskap_json"

        rows = payload if isinstance(payload, list) else [payload]
        if not rows:
            return False, "empty_regnskap_json"

        exact_org = False
        for row in rows:
            if not isinstance(row, dict):
                continue
            virksomhet = row.get("virksomhet") or {}
            if str(virksomhet.get("organisasjonsnummer") or "") == company.orgnr:
                exact_org = True
                break

        if exact_org and (urlparse(url).hostname or "").lower() == "data.brreg.no":
            return True, "trusted_brreg_regnskap"
        return False, "company_identity_not_proven"

    if not body:
        return False, "empty_body"

    # A Brreg-registered website gets the strongest non-registry trust signal.
    if _same_official_domain(company.website, url):
        return True, "registered_official_domain"

    low = body.lower()
    signals = 0
    if company.orgnr and company.orgnr in body:
        signals += 2
    tokens = _name_tokens(company.name)
    if tokens:
        matched = sum(1 for t in tokens if t in low)
        if matched >= max(1, min(2, len(tokens))):
            signals += 1

    if signals >= 2:
        return True, "identity_verified"
    return False, "company_identity_not_proven"


def _store(
    session: Session,
    company: Company,
    url: str,
    kind: str,
    status: int | None,
    body: str | None,
    identity_verified: bool,
    rejection_reason: str | None = None,
) -> Source | None:
    canon = canonicalize_url(url)
    uh = sha256_hex(canon)
    existing = session.query(Source).filter_by(company_id=company.id, url_hash=uh).one_or_none()
    ch = content_hash(body) if body else None
    now = datetime.now(timezone.utc).replace(tzinfo=None)

    if existing is None:
        src = Source(
            company_id=company.id,
            url=url,
            url_canonical=canon,
            url_hash=uh,
            content_hash=ch,
            kind=kind,
            status=status,
            body=body,
            fetched_at=now,
            identity_verified=identity_verified,
            rejection_reason=rejection_reason,
        )
        session.add(src)
        session.flush()
        return src

    existing.fetched_at = now
    existing.status = status
    existing.body = body
    existing.content_hash = ch
    existing.identity_verified = identity_verified
    existing.rejection_reason = rejection_reason
    existing.kind = kind
    session.flush()
    return existing


async def collect(
    session: Session,
    http: SafeHTTPClient,
    search: SearchAdapter,
    company: Company,
) -> list[Source]:
    # 1) Fetch first-party Brreg identity before constructing website URLs.
    # This also fills Company.website from Brreg even when the DB copy was stale.
    entity_url = STATIC_SOURCES_TEMPLATE[0].format(orgnr=company.orgnr)
    role_url = STATIC_SOURCES_TEMPLATE[1].format(orgnr=company.orgnr)
    urls: list[tuple[str, str]] = [(entity_url, "brreg"), (role_url, "brreg")]

    seen: set[str] = set()
    sources: list[Source] = []

    async def fetch_and_store(url: str, kind: str) -> Source | None:
        key = canonicalize_url(url)
        if key in seen:
            return None
        seen.add(key)
        resp = await http.get(url, use_cache=True)
        if resp is None:
            return None
        body = resp.text[:500_000] if resp.status_code == 200 else None
        verified, reason = verify_source_identity(company, url, body or "", kind)
        src = _store(
            session,
            company,
            url,
            kind,
            resp.status_code,
            body if verified else None,
            verified,
            None if verified else reason,
        )
        if src and verified:
            sources.append(src)
            return src
        if src:
            log.warning("source_rejected", orgnr=company.orgnr, url=url, reason=reason)
        return None

    entity_src = await fetch_and_store(entity_url, "brreg")
    if entity_src and entity_src.body:
        registered = _registered_website_from_brreg(entity_src.body)
        if registered:
            company.website = registered
            session.flush()

    await fetch_and_store(role_url, "brreg")

    # 2) Registered company website is now a trusted candidate by host match.
    if company.website:
        website_url = company.website.strip()
        if "://" not in website_url:
            website_url = "https://" + website_url
        await fetch_and_store(website_url, "website")

    # 3) Public annual-account JSON from Regnskapsregisteret. This is an
    # authoritative Brreg source and is much richer than the entity feed for
    # companies whose latest accounts are available.
    await fetch_and_store(REGNSKAP_URL.format(orgnr=company.orgnr), "regnskap")

    # 4) Discovery-only search. Only URLs that pass identity verification are
    # allowed into the trusted source set.
    for url in await search.find_official_urls(company.name, company.orgnr):
        if len(sources) >= 14:
            break
        await fetch_and_store(url, "search")

    return sources
